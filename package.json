{
  "name": "@makcimbx/opencode-read-audio",
  "version": "0.3.0",
  "description": "OpenCode plugin for analyzing local audio files through OpenRouter audio-capable chat models.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "prebuild": "rm -rf dist",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external",
    "test": "bun test tests/unit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-ai",
    "openrouter",
    "audio",
    "audio-analysis",
    "transcription",
    "multimodal",
    "plugin"
  ],
  "author": "Yuji Hatakeyama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makcimbx/opencode-read-audio.git"
  },
  "homepage": "https://github.com/makcimbx/opencode-read-audio#readme",
  "bugs": {
    "url": "https://github.com/makcimbx/opencode-read-audio/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.33"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@opencode-ai/plugin": "^1.18.33",
    "@tsconfig/node22": "^22.0.6",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.26",
    "file-type": "^22.1.1",
    "xdg-basedir": "^5.1.0"
  }
}
